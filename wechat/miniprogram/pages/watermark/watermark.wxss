page {
  height: 100vh;
  overflow: hidden;
}

.supported-platforms {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.supported-platforms__label {
  flex: none;
  color: var(--ink-soft);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.4;
}

.supported-platforms__list {
  display: flex;
  min-width: 0;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 8rpx;
}

.platform-tag {
  min-height: 42rpx;
  padding: 0 13rpx;
  border: 1rpx solid var(--line-red);
  border-radius: 6rpx;
  background: var(--surface-red);
  color: var(--xhs-red);
  font-size: 22rpx;
  font-weight: 800;
  line-height: 40rpx;
  white-space: nowrap;
}

.textarea {
  display: block;
  min-height: 230rpx;
  margin-top: 18rpx;
  border: 0;
  background: #f6f6f6;
}

.input-panel .submit-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-width: 100%;
  margin-top: 20rpx;
  line-height: 1.2;
}

.input-panel .submit-button[disabled] {
  background: #d8d8d8;
  color: #ffffff;
}

.button--loading {
  opacity: 0.65;
}

.notice {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid rgba(42, 34, 38, 0.06);
  border-radius: 8rpx;
  background: #f7f7f7;
  color: var(--muted);
  font-size: 22rpx;
  line-height: 1.6;
  box-shadow: none;
}

.notice__text {
  min-width: 0;
  flex: 1;
}

.notice__link {
  flex: none;
  color: var(--xhs-red);
  font-weight: 800;
  white-space: nowrap;
}

.share-entry {
  display: flex;
  min-height: 72rpx;
  align-items: center;
  justify-content: center;
  margin-top: 16rpx;
  background: transparent;
  color: var(--ink-soft);
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.35;
}

.share-entry--pressed {
  opacity: 0.6;
}
