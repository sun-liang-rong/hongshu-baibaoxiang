<navigation-bar title="红薯百宝箱" back="{{false}}" color="#ffffff" background="#ff2442"></navigation-bar>
<network-status></network-status>
<scroll-view class="page-scroll" scroll-y type="list">
  <view class="page-block">
    <view class="tool-intro">
      <view class="tool-intro__main">
        <view class="tool-title">粘贴链接，提取素材</view>
        <view class="tool-subtitle">支持分享链接或完整分享口令</view>
      </view>
      <view wx:if="{{quotaReady}}" class="quota-text {{quota.remaining <= 0 ? 'quota-text--empty' : ''}}">
        今日 {{quota.remaining}} 次
      </view>
    </view>

    <view class="input-panel">
      <view class="supported-platforms" aria-label="支持平台：小红薯、抖应、快手">
        <text class="supported-platforms__label">支持平台</text>
        <view class="supported-platforms__list">
          <text class="platform-tag">小红薯</text>
          <text class="platform-tag">抖应</text>
          <text class="platform-tag">快手</text>
        </view>
      </view>
      <textarea
        class="textarea"
        value="{{text}}"
        maxlength="1200"
        placeholder="粘贴任意已支持平台的分享链接或完整口令"
        bindinput="onInput"
      />
      <button
        class="button button--primary submit-button {{loading ? 'button--loading' : ''}}"
        disabled="{{loading || (quotaReady && quota.remaining <= 0)}}"
        loading="{{loading}}"
        bindtap="primaryAction"
      >
        {{quotaReady && quota.remaining <= 0 ? '今日次数已用完' : (text ? '开始解析' : '粘贴链接并解析')}}
      </button>
      <view wx:if="{{requestError}}" class="request-error" aria-role="alert">
        <view class="request-error__main">
          <view class="request-error__title">解析没有完成</view>
          <view class="request-error__desc">{{requestError}}，已保留当前链接</view>
        </view>
        <button class="request-error__retry" bindtap="retryRequest">重新尝试</button>
      </view>
    </view>

    <view class="notice" aria-role="note">
      <text class="notice__text">仅供个人学习和内容备份，请尊重原创作者版权。</text>
      <text class="notice__link" bindtap="goDisclaimer">查看免责声明</text>
    </view>
    <button class="share-entry" open-type="share" hover-class="share-entry--pressed">分享工具给朋友</button>
  </view>
</scroll-view>
