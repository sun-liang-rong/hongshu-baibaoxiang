<navigation-bar title="解析结果" color="#25232a" background="transparent"></navigation-bar>
<network-status></network-status>
<scroll-view class="page-scroll" scroll-y type="list">
  <block wx:if="{{result}}">
    <view class="result-page">
      <view class="creator-row">
        <image wx:if="{{creatorAvatarUrl}}" class="creator-avatar" src="{{creatorAvatarUrl}}" mode="aspectFill"></image>
        <view wx:else class="creator-avatar creator-avatar--placeholder">{{platformInitial}}</view>
        <view class="creator-main">
          <view class="creator-name">{{creatorName}}</view>
          <view class="creator-meta">{{platformLabel}}{{publishedAtText ? ' · ' + publishedAtText : ''}}</view>
        </view>
      </view>

      <view class="section section--first">
        <view class="media-head">
          <view>
            <view class="section__title">无水印素材</view>
            <view class="media-count">{{activeVideo ? '视频素材' + (videoMeta ? ' · ' + videoMeta : '') : imageUrls.length + ' 张图片'}}</view>
          </view>
          <button wx:if="{{!activeVideo && imageUrls.length > 1}}" class="save-all-button" disabled="{{savingAll}}" bindtap="saveAllImages">{{savingAll ? '保存中 ' + saveCompleted + '/' + saveTotal : '保存全部'}}</button>
        </view>

        <scroll-view wx:if="{{result.data.parts.length > 1}}" class="part-tabs" scroll-x enhanced show-scrollbar="{{false}}">
          <view class="part-tabs__inner">
            <button wx:if="{{result.data.video}}" class="part-tab {{activePartIndex === -1 ? 'part-tab--active' : ''}}" data-index="-1" bindtap="selectPart">主视频</button>
            <block wx:for="{{result.data.parts}}" wx:key="cid">
              <button wx:if="{{item.video}}" class="part-tab {{activePartIndex === index ? 'part-tab--active' : ''}}" data-index="{{index}}" bindtap="selectPart">P{{item.page}} {{item.title}}</button>
            </block>
          </view>
        </scroll-view>

        <view wx:if="{{savePanelVisible}}" class="save-progress" aria-role="status">
          <view class="save-progress__head">
            <view>
              <view wx:if="{{savingAll}}" class="save-progress__title">正在保存图片</view>
              <view wx:elif="{{saveHasFailures}}" class="save-progress__title">部分图片保存失败</view>
              <view wx:else class="save-progress__title">图片保存完成</view>
              <view class="save-progress__summary">已保存 {{savedCount}} 张，共 {{saveTotal}} 张</view>
            </view>
            <button wx:if="{{!savingAll}}" class="save-progress__close" aria-label="关闭保存进度" bindtap="closeSavePanel">×</button>
          </view>
          <view class="save-progress__track"><view class="save-progress__bar" style="width: {{savePercent}}%;"></view></view>
          <view wx:if="{{saveHasFailures}}" class="failed-list">
            <view wx:for="{{failedImages}}" wx:key="index" class="failed-item">
              <image class="failed-item__image" src="{{item.url}}" mode="aspectFill"></image>
              <view class="failed-item__main"><view class="failed-item__title">第 {{item.index + 1}} 张保存失败</view><view class="failed-item__desc">检查网络或相册权限后重试</view></view>
              <button class="failed-item__retry" loading="{{retryingIndex === item.index}}" disabled="{{retryingIndex >= 0}}" data-index="{{item.index}}" data-url="{{item.url}}" bindtap="retryFailedImage">重试</button>
            </view>
          </view>
        </view>

        <block wx:if="{{activeVideo}}">
          <view class="video-card"><video id="watermarkVideo" class="media-video" src="{{activeVideo.url}}" poster="{{result.data.cover_url}}" controls show-center-play-btn show-fullscreen-btn object-fit="contain"></video></view>
          <button class="button button--ghost" bindtap="saveVideo">保存当前视频</button>
        </block>
        <view wx:else class="media-grid">
          <view wx:for="{{imageUrls}}" wx:key="*this" class="media-item">
            <image class="media-image" src="{{item}}" mode="aspectFill" lazy-load bindtap="previewImage" data-url="{{item}}"></image>
            <button class="small-button" bindtap="saveImage" data-url="{{item}}">保存图片</button>
          </view>
        </view>
      </view>

      <view wx:if="{{result.data.statistics}}" class="statistics-row">
        <view class="statistic"><text class="statistic__value">{{result.data.statistics.likes === null ? '-' : result.data.statistics.likes}}</text><text class="statistic__label">点赞</text></view>
        <view class="statistic"><text class="statistic__value">{{result.data.statistics.comments === null ? '-' : result.data.statistics.comments}}</text><text class="statistic__label">评论</text></view>
        <view class="statistic"><text class="statistic__value">{{result.data.statistics.shares === null ? '-' : result.data.statistics.shares}}</text><text class="statistic__label">分享</text></view>
        <view class="statistic"><text class="statistic__value">{{result.data.statistics.favorites === null ? '-' : result.data.statistics.favorites}}</text><text class="statistic__label">收藏</text></view>
      </view>

      <view class="section">
        <view class="section__title">{{result.data.title || '作品信息'}}</view>
        <view class="content-box">{{result.data.description || result.data.title || '暂无文案'}}</view>
        <view wx:if="{{result.data.music}}" class="music-line">音乐 · {{result.data.music.title || '原声'}}{{result.data.music.author ? ' / ' + result.data.music.author : ''}}</view>
        <view class="result-actions">
          <button class="button button--primary" bindtap="copyContent">复制文案</button>
          <button wx:if="{{result.data.original_url}}" class="button button--ghost" bindtap="copyOriginalUrl">复制原链接</button>
          <button class="button button--ghost {{favorited ? 'button--favorited' : ''}}" bindtap="toggleFavorite">{{favorited ? '已收藏' : '收藏'}}</button>
          <button class="button button--ghost" open-type="share">分享工具</button>
        </view>
      </view>
    </view>
  </block>
  <empty-state wx:else title="暂无解析结果" desc="请先粘贴作品链接并完成解析"></empty-state>
</scroll-view>
