page {
  height: 100vh;
  overflow: hidden;
}

.result-page {
  padding-bottom: 64rpx;
}

.creator-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 4rpx 0 20rpx;
  border-bottom: 1rpx solid var(--line);
}

.creator-avatar {
  display: flex;
  width: 76rpx;
  height: 76rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f1f1f1;
  color: var(--ink-soft);
  font-size: 28rpx;
  font-weight: 800;
}

.creator-main {
  min-width: 0;
  flex: 1;
}

.creator-name {
  overflow: hidden;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.creator-meta {
  margin-top: 4rpx;
  color: var(--muted);
  font-size: 23rpx;
  line-height: 1.4;
}

.section {
  margin-top: 22rpx;
}

.section--first {
  margin-top: 0;
}

.section__title {
  margin-bottom: 0;
}

.media-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 18rpx;
}

.media-count {
  margin-top: 5rpx;
  color: var(--muted);
  font-size: 24rpx;
}

.save-all-button {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  min-height: 66rpx;
  padding: 0 22rpx;
  border-radius: 10rpx;
  background: var(--xhs-red);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.35;
  white-space: nowrap;
}

.save-all-button[disabled] {
  background: #d8d8d8;
}

.part-tabs {
  width: 100%;
  margin-bottom: 18rpx;
  white-space: nowrap;
}

.part-tabs__inner {
  display: inline-flex;
  gap: 10rpx;
  padding-right: 24rpx;
}

.part-tab {
  display: inline-flex;
  max-width: 360rpx;
  min-height: 62rpx;
  align-items: center;
  padding: 0 18rpx;
  overflow: hidden;
  border: 1rpx solid var(--line);
  border-radius: 8rpx;
  background: #ffffff;
  color: var(--ink-soft);
  font-size: 23rpx;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.part-tab--active {
  border-color: var(--xhs-red);
  background: var(--surface-red);
  color: var(--xhs-red);
  font-weight: 800;
}

.save-progress {
  margin-bottom: 18rpx;
  padding: 20rpx;
  border: 1rpx solid var(--line-red);
  border-radius: 14rpx;
  background: #fffafb;
}

.save-progress__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.save-progress__title {
  color: var(--ink);
  font-size: 27rpx;
  font-weight: 900;
  line-height: 1.4;
}

.save-progress__summary {
  margin-top: 5rpx;
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.45;
}

.save-progress__close {
  display: flex;
  width: 58rpx;
  min-height: 58rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f1f1f1;
  color: var(--muted);
  font-size: 34rpx;
  line-height: 1.2;
}

.save-progress__track {
  height: 12rpx;
  margin-top: 16rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #f0e7e9;
}

.save-progress__bar {
  height: 100%;
  border-radius: inherit;
  background: var(--xhs-red);
  transition: width 180ms ease;
}

.failed-list {
  margin-top: 14rpx;
  border-top: 1rpx solid var(--line-red);
}

.failed-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding-top: 14rpx;
}

.failed-item__image {
  width: 70rpx;
  height: 70rpx;
  flex: none;
  border-radius: 10rpx;
  background: #eeeeee;
}

.failed-item__main {
  min-width: 0;
  flex: 1;
}

.failed-item__title {
  color: var(--ink);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.4;
}

.failed-item__desc {
  margin-top: 3rpx;
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.4;
}

.failed-item__retry {
  display: flex;
  min-width: 92rpx;
  min-height: 64rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  padding: 0 14rpx;
  border-radius: 10rpx;
  background: var(--surface-red);
  color: var(--xhs-red);
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.35;
}

.video-card {
  overflow: hidden;
  border: 0;
  border-radius: 30rpx;
  background: #111111;
  box-shadow: 0 14rpx 38rpx rgba(84, 62, 72, 0.12);
}

.media-video {
  display: block;
  width: 100%;
  height: 430rpx;
  background: #111111;
}

.media-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.media-item {
  overflow: hidden;
  border: 0;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.7);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.76), 0 10rpx 28rpx rgba(84, 62, 72, 0.055);
}

.media-image {
  display: block;
  width: 100%;
  height: 230rpx;
  background: #f1edef;
}

.media-image:active {
  opacity: 0.86;
}

.small-button {
  width: 100%;
  border: 0;
  border-top: 1rpx solid rgba(60, 51, 58, 0.06);
  border-radius: 0;
  background: rgba(255, 49, 80, 0.08);
  color: var(--xhs-red);
}

.section > .button {
  margin-top: 18rpx;
}

.statistics-row {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  margin-top: 22rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid var(--line);
  border-bottom: 1rpx solid var(--line);
}

.statistic {
  display: flex;
  min-width: 0;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.statistic__value {
  max-width: 100%;
  overflow: hidden;
  color: var(--ink);
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.3;
  text-overflow: ellipsis;
}

.statistic__label {
  color: var(--muted);
  font-size: 22rpx;
  line-height: 1.3;
}

.music-line {
  margin-top: 14rpx;
  color: var(--muted);
  font-size: 23rpx;
  line-height: 1.5;
}

.result-actions {
  display: flex;
  width: 100%;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.result-actions .button {
  flex: 1 1 180rpx;
  min-width: 0;
  min-height: 78rpx;
  font-size: 25rpx;
  line-height: 1.35;
}

@media (min-width: 480px) {
  .media-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}
