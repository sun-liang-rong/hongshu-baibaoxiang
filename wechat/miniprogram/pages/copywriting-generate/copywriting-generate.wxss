page {
  height: 100vh;
  overflow: hidden;
}

.page-wrap {
  padding-bottom: calc(132rpx + env(safe-area-inset-bottom));
}

.result-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 20rpx;
  flex-wrap: wrap;
}

.section-subtitle {
  margin-top: 6rpx;
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.45;
}

.advanced-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 82rpx;
  margin-top: 14rpx;
  padding: 14rpx 2rpx;
  border-top: 1rpx solid var(--line);
  background: transparent;
}

.advanced-toggle--pressed {
  opacity: 0.6;
}

.advanced-toggle__title {
  color: var(--ink);
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.35;
}

.advanced-toggle__desc {
  margin-top: 4rpx;
  color: var(--muted);
  font-size: 23rpx;
  line-height: 1.35;
}

.advanced-toggle__action {
  flex: none;
  color: var(--xhs-red);
  font-size: 24rpx;
  font-weight: 800;
}

.advanced-fields {
  margin-top: 0;
  padding: 18rpx 0 2rpx;
  border-top: 1rpx solid var(--line);
}

.picker-box {
  position: relative;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 14rpx 12rpx 16rpx;
}

.picker-box__label,
.picker-box__value {
  display: block;
}

.picker-box__label {
  color: var(--muted);
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.25;
}

.picker-box__value {
  margin-top: 4rpx;
  color: var(--ink);
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.25;
}

.picker-box__chevron {
  color: var(--muted);
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1;
}

.form-card .cta-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  margin-top: 16rpx;
  line-height: 1.2;
}

.button--loading {
  opacity: 0.65;
}

.result-section {
  padding-bottom: calc(220rpx + env(safe-area-inset-bottom));
}

.result-title {
  color: var(--ink);
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.42;
  word-break: break-word;
  overflow-wrap: anywhere;
}

.tag-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.suggestions {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 12rpx;
  background: var(--mint-soft);
  color: var(--ink);
}

.suggestions__title {
  margin-bottom: 8rpx;
  color: var(--mint);
  font-size: 27rpx;
  font-weight: 800;
}

.suggestions__item {
  position: relative;
  margin-top: 8rpx;
  padding-left: 20rpx;
  color: var(--ink-soft);
  font-size: 26rpx;
  line-height: 1.52;
  word-break: break-word;
  overflow-wrap: anywhere;
}

.suggestions__item::before {
  content: "";
  position: absolute;
  left: 2rpx;
  top: 16rpx;
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
  background: var(--mint);
}

.refresh-button {
  width: 100%;
  margin-top: 20rpx;
}

.quota-tip {
  display: flex;
  min-height: 72rpx;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-top: 20rpx;
  padding: 15rpx 20rpx;
  border: 1rpx solid var(--line);
  border-radius: 10rpx;
  background: #f7f7f7;
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.45;
  text-align: center;
}

.quota-tip__icon {
  width: 30rpx;
  height: 30rpx;
  flex: none;
  border: 2rpx solid #b5b5b5;
  border-radius: 50%;
  color: #9a9a9a;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 27rpx;
  text-align: center;
}

.result-dock {
  position: fixed;
  bottom: calc(104rpx + env(safe-area-inset-bottom) + 12rpx);
  left: 50%;
  z-index: 20;
  width: calc(100% - 48rpx);
  max-width: 702rpx;
  display: flex;
  align-items: stretch;
  gap: 12rpx;
  padding: 12rpx;
  border: 1rpx solid rgba(42, 34, 38, 0.08);
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 12rpx 36rpx rgba(50, 36, 42, 0.14);
  transform: translateX(-50%);
}

.result-dock .button {
  width: 0;
  min-width: 0;
  flex: 1;
  min-height: 76rpx;
  font-size: 25rpx;
  padding: 14rpx 18rpx;
  line-height: 1.35;
}
