page {
  height: 100vh;
  overflow: hidden;
}

.page {
  display: flex;
  min-height: 0;
  flex: 1;
  flex-direction: column;
}

.list-scroll {
  padding: 8rpx 24rpx calc(env(safe-area-inset-bottom) + 48rpx);
  box-sizing: border-box;
}

.loading-state {
  padding: 120rpx 0;
  color: var(--muted);
  font-size: 25rpx;
  text-align: center;
}

.clear-button,
.load-more-button {
  width: 100%;
  min-height: 68rpx;
  margin-top: 18rpx;
  border: 1rpx solid var(--line);
  border-radius: 10rpx;
  background: #ffffff;
  color: var(--ink-soft);
  font-size: 25rpx;
  font-weight: 800;
  line-height: 68rpx;
}

.clear-button {
  width: auto;
  min-height: 64rpx;
  margin: 18rpx auto 16rpx;
  padding: 0 24rpx;
  border-color: transparent;
  background: transparent;
  color: #a84747;
  line-height: 64rpx;
}
