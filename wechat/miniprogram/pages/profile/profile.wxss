page {
  height: 100vh;
  overflow: hidden;
}

.user-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx;
  border-color: var(--xhs-red);
  background: var(--xhs-red);
  box-shadow: 0 10rpx 26rpx rgba(255, 36, 66, 0.16);
}

.brand-mark {
  width: 80rpx;
  height: 80rpx;
  flex: none;
  border-radius: 20rpx;
  background: #ffffff;
  color: var(--xhs-red);
  font-size: 32rpx;
  font-weight: 900;
  line-height: 80rpx;
  text-align: center;
}

.user-card__main {
  min-width: 0;
}

.brand-name {
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.3;
  word-break: break-word;
}

.quota-card {
  margin-top: 16rpx;
  padding: 22rpx;
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  background: #ffffff;
}

.quota-card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.quota-card__title {
  color: var(--ink);
  font-size: 29rpx;
  font-weight: 900;
}

.quota-card__desc {
  margin-top: 5rpx;
  color: var(--muted);
  font-size: 24rpx;
}

.quota-retry {
  flex: none;
  min-height: 62rpx;
  padding: 0 18rpx;
  border-radius: 10rpx;
  background: var(--surface-red);
  color: var(--xhs-red);
  font-size: 23rpx;
  font-weight: 800;
  line-height: 62rpx;
}

.subtext {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 24rpx;
  line-height: 1.4;
}

.stat-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  margin-top: 18rpx;
  overflow: hidden;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  background: #ffffff;
}

.stat-item {
  min-width: 0;
  padding: 20rpx 6rpx;
  border-right: 1rpx solid var(--line);
  text-align: center;
}

.stat-item:last-child {
  border-right: 0;
}

.stat-item__num {
  color: var(--ink);
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.15;
}

.stat-item__label {
  margin-top: 6rpx;
  color: var(--muted);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.3;
}

.link-list {
  margin-top: 16rpx;
  overflow: hidden;
}

.link-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 104rpx;
  padding: 0 22rpx;
  border-bottom: 1rpx solid var(--line);
}

.link-item__main {
  min-width: 0;
  flex: 1;
}

.link-item--share {
  position: relative;
}

.link-item__share-hit {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1;
  width: 100%;
  height: 100%;
  padding: 0;
  border-radius: 0;
  background: transparent;
  opacity: 0;
}

.link-item__share-hit::after {
  border: 0;
}

.link-item:last-child {
  border-bottom: 0;
}

.link-item--pressed {
  background: #f7f7f7;
}

.link-item__title {
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.4;
  word-break: break-word;
}

.link-item__desc {
  margin-top: 4rpx;
  color: var(--muted);
  font-size: 23rpx;
  line-height: 1.35;
  word-break: break-word;
}

.link-item__arrow {
  flex: none;
  color: #b5b5b5;
  font-size: 38rpx;
  line-height: 1;
}

.about-box {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  color: var(--muted);
  font-size: 23rpx;
  line-height: 1.55;
}
