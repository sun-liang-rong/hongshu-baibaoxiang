page {
  height: 100vh;
  overflow: hidden;
}

.page {
  display: flex;
  min-height: 0;
  flex: 1;
  flex-direction: column;
}

.list-scroll {
  padding: 8rpx 24rpx 132rpx;
  box-sizing: border-box;
}

.loading-state {
  padding: 120rpx 0;
  color: var(--muted);
  font-size: 25rpx;
  text-align: center;
}

.load-more-button {
  width: 100%;
  min-height: 68rpx;
  margin: 18rpx 0 32rpx;
  border: 1rpx solid var(--line);
  border-radius: 10rpx;
  background: #ffffff;
  color: var(--ink-soft);
  font-size: 25rpx;
  font-weight: 800;
  line-height: 68rpx;
}
