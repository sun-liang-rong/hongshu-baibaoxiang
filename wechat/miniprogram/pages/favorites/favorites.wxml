<navigation-bar title="我的收藏" color="#25232a" background="transparent"></navigation-bar>
<network-status></network-status>
<view class="page">
  <filter-tabs filters="{{filters}}" active="{{activeType}}" bind:change="switchType"></filter-tabs>

  <scroll-view
    class="list-scroll"
    scroll-y
    type="list"
    lower-threshold="120"
    bindscrolltolower="loadMore"
  >
    <view wx:if="{{loading && !items.length}}" class="skeleton-list">
      <view wx:for="{{skeletonItems}}" wx:key="*this" class="skeleton-card">
        <view class="skeleton-line skeleton-line--meta"></view>
        <view class="skeleton-line skeleton-line--title"></view>
        <view class="skeleton-line skeleton-line--body"></view>
      </view>
    </view>
    <empty-state
      wx:elif="{{loadError && !items.length}}"
      title="加载失败"
      desc="{{loadError}}"
      action-text="重新加载"
      bind:action="retry"
    ></empty-state>
    <block wx:elif="{{items.length}}">
      <record-card
        wx:for="{{items}}"
        wx:key="id"
        item="{{item}}"
        bind:open="open"
        bind:copy="copy"
        bind:remove="remove"
      ></record-card>
      <button
        wx:if="{{hasMore}}"
        class="load-more-button"
        loading="{{loadingMore}}"
        bindtap="loadMore"
      >
        加载更多
      </button>
    </block>
    <empty-state
      wx:else
      title="暂无收藏"
      desc="在解析结果、标题和文案页面收藏的内容会出现在这里"
      action-text="去使用工具"
      bind:action="createContent"
    ></empty-state>
  </scroll-view>
</view>
