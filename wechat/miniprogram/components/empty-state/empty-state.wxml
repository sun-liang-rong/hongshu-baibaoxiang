<view class="empty-state">
  <view class="empty-state__visual">
    <view class="empty-state__sheet">
      <view class="empty-state__line empty-state__line--primary"></view>
      <view class="empty-state__line empty-state__line--long"></view>
      <view class="empty-state__line empty-state__line--short"></view>
    </view>
  </view>
  <view class="empty-state__title">{{title}}</view>
  <view wx:if="{{desc}}" class="empty-state__desc">{{desc}}</view>
  <button
    wx:if="{{actionText}}"
    class="empty-state__action"
    hover-class="empty-state__action--pressed"
    bindtap="action"
  >
    {{actionText}}
  </button>
</view>
