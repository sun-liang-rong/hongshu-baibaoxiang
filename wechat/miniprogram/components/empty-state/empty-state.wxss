.empty-state {
  padding: 80rpx 32rpx 60rpx;
  text-align: center;
}

.empty-state__visual {
  position: relative;
  width: 112rpx;
  height: 112rpx;
  margin: 0 auto 22rpx;
  border-radius: 50%;
  background: #f2f2f2;
}

.empty-state__sheet {
  position: absolute;
  left: 30rpx;
  top: 25rpx;
  width: 52rpx;
  height: 62rpx;
  padding: 16rpx 10rpx 0;
  border: 2rpx solid #c8c8c8;
  border-radius: 6rpx;
  background: #ffffff;
}

.empty-state__line {
  height: 3rpx;
  margin-bottom: 8rpx;
  border-radius: 2rpx;
  background: #d4d4d4;
}

.empty-state__line--primary {
  width: 26rpx;
  background: #ff8b9d;
}

.empty-state__line--long {
  width: 30rpx;
}

.empty-state__line--short {
  width: 20rpx;
}

.empty-state__title {
  color: var(--ink);
  font-size: 29rpx;
  font-weight: 800;
  line-height: 1.4;
}

.empty-state__desc {
  max-width: 520rpx;
  margin: 10rpx auto 0;
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.55;
}

.empty-state__action {
  min-height: 76rpx;
  margin: 28rpx auto 0;
  padding: 0 30rpx;
  border-radius: 10rpx;
  background: var(--xhs-red);
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 76rpx;
}

.empty-state__action--pressed {
  background: var(--xhs-red-dark);
}
