.record-card {
  margin-top: 12rpx;
  overflow: hidden;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  background: var(--surface);
}

.record-card__content {
  padding: 20rpx 20rpx 16rpx;
}

.record-card__content--pressed {
  background: #fafafa;
}

.record-card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.record-card__time {
  flex: none;
  color: var(--muted);
  font-size: 22rpx;
}

.record-card__title {
  display: -webkit-box;
  margin-top: 14rpx;
  overflow: hidden;
  color: var(--ink);
  font-size: 29rpx;
  font-weight: 800;
  line-height: 1.45;
  word-break: break-word;
  overflow-wrap: anywhere;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.record-card__summary {
  display: -webkit-box;
  margin-top: 8rpx;
  overflow: hidden;
  color: var(--ink-soft);
  font-size: 25rpx;
  line-height: 1.5;
  word-break: break-word;
  overflow-wrap: anywhere;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.record-card__open {
  margin-top: 12rpx;
  color: var(--xhs-red);
  font-size: 23rpx;
  font-weight: 800;
}

.record-card__chevron {
  margin-left: 3rpx;
  font-size: 28rpx;
}

.record-card__actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 4rpx;
  min-height: 66rpx;
  padding: 6rpx 12rpx;
  border-top: 1rpx solid var(--line);
}

.record-card__action {
  min-height: 68rpx;
  padding: 0 20rpx;
  border-radius: 8rpx;
  background: transparent;
  color: var(--ink-soft);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.35;
}

.record-card__remove {
  color: #a84747 !important;
}

.record-card__action--pressed {
  background: #f2f2f2 !important;
}
