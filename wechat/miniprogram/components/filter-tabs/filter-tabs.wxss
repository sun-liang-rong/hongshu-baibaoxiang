.filter-row {
  display: flex;
  gap: 30rpx;
  min-height: 76rpx;
  padding: 4rpx 24rpx 0;
  overflow-x: auto;
  border-bottom: 1rpx solid var(--line);
  background: #ffffff;
}

.filter {
  position: relative;
  flex: none;
  min-height: 72rpx;
  padding: 0 4rpx;
  color: var(--ink-soft);
  font-size: 25rpx;
  font-weight: 700;
  line-height: 72rpx;
}

.filter--active {
  color: var(--ink);
  font-weight: 900;
}

.filter--active::after {
  content: "";
  position: absolute;
  right: 8rpx;
  bottom: 0;
  left: 8rpx;
  height: 5rpx;
  border-radius: 3rpx;
  background: var(--xhs-red);
}
