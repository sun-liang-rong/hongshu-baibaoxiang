page {
  --xhs-red: #ff2442;
  --xhs-red-dark: #e61e3c;
  --ink: #1f1f1f;
  --ink-soft: #555555;
  --muted: #8a8a8a;
  --line: #ebebeb;
  --line-red: #ffd7df;
  --surface: #ffffff;
  --surface-warm: #fafafa;
  --surface-red: #fff0f3;
  --mint: #0f9f88;
  --mint-soft: #e9f8f4;
  --amber: #b46b12;
  --amber-soft: #fff5df;
  --shadow-card: 0 8rpx 24rpx rgba(31, 31, 31, 0.04);
  --shadow-action: 0 10rpx 22rpx rgba(255, 36, 66, 0.2);

  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Helvetica, Arial, sans-serif;
  background: #f7f7f7;
}

view,
text,
input,
textarea,
button {
  box-sizing: border-box;
}

button {
  display: block;
  width: auto;
  min-width: 0;
  margin: 0;
  padding: 0;
  border: 0;
  box-sizing: border-box;
}

button::after {
  display: none;
  border: 0;
}

input,
textarea {
  caret-color: var(--xhs-red);
}

.page-scroll,
.list-scroll {
  flex: 1;
  min-height: 0;
}

.page-wrap,
.page-block,
.profile,
.doc-page,
.result-page {
  padding: 28rpx 28rpx 132rpx;
}

.xhs-card,
.form-card,
.result-section,
.input-panel,
.doc-card,
.section,
.user-card,
.link-list,
.about-box,
.notice {
  border: 1rpx solid rgba(42, 34, 38, 0.07);
  border-radius: 12rpx;
  background: var(--surface);
  box-shadow: var(--shadow-card);
}

.xhs-soft-panel {
  border: 1rpx solid rgba(255, 36, 66, 0.1);
  border-radius: 16rpx;
  background: var(--surface-warm);
}

.xhs-chip,
.tag,
.result-count {
  display: inline-flex;
  align-items: center;
  min-height: 46rpx;
  padding: 0 17rpx;
  border-radius: 999rpx;
  background: var(--surface-red);
  color: var(--xhs-red);
  font-size: 23rpx;
  font-weight: 800;
  line-height: 46rpx;
  box-shadow: inset 0 0 0 1rpx var(--line-red);
}

.tag {
  max-width: 100%;
  height: auto;
  padding-top: 7rpx;
  padding-bottom: 7rpx;
  line-height: 1.35;
  white-space: normal;
  word-break: break-word;
  overflow-wrap: anywhere;
}

.xhs-section-title,
.section-title,
.field__label,
.panel-title,
.section__title {
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.28;
}

.page-head {
  position: relative;
  padding: 4rpx 4rpx 2rpx;
}

.tool-intro {
  position: relative;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  min-height: 144rpx;
  padding: 24rpx;
  overflow: hidden;
  border-radius: 12rpx;
  border: 1rpx solid var(--line-red);
  background: var(--surface-red);
  box-shadow: none;
}

.tool-intro__main {
  min-width: 0;
  flex: 1;
}

.tool-title {
  color: var(--ink);
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.28;
  word-break: break-word;
}

.tool-subtitle {
  margin-top: 8rpx;
  color: var(--ink-soft);
  font-size: 25rpx;
  line-height: 1.45;
}

.quota-text {
  flex: none;
  min-height: 46rpx;
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  background: var(--xhs-red);
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.4;
  white-space: nowrap;
}

.quota-text--empty {
  background: #d9d9d9;
  color: #ffffff;
}

.creator-card {
  position: relative;
  overflow: hidden;
  padding: 28rpx;
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  background: var(--surface);
}

.page-kicker {
  position: relative;
  z-index: 1;
  display: inline-flex;
  align-items: center;
  min-height: 32rpx;
  padding: 0;
  background: transparent;
  color: var(--xhs-red);
  font-size: 23rpx;
  font-weight: 800;
  line-height: 32rpx;
}

.page-title {
  position: relative;
  z-index: 1;
  margin-top: 4rpx;
  color: var(--ink);
  font-size: 35rpx;
  font-weight: 900;
  line-height: 1.25;
}

.page-subtitle {
  position: relative;
  z-index: 1;
  margin-top: 6rpx;
  color: var(--ink-soft);
  font-size: 24rpx;
  line-height: 1.5;
}

.quota-badge {
  flex: none;
  min-height: 46rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: var(--surface-red);
  color: var(--xhs-red);
  font-size: 23rpx;
  font-weight: 800;
  line-height: 46rpx;
}

.quota-badge--empty {
  background: #f1f1f1;
  color: var(--muted);
}

.form-card,
.result-section,
.input-panel,
.section {
  margin-top: 16rpx;
  padding: 22rpx;
}

.form-card,
.input-panel {
  border-color: rgba(255, 36, 66, 0.1);
}

.field + .field {
  margin-top: 18rpx;
}

.input,
.textarea {
  width: 100%;
  margin-top: 12rpx;
  padding: 0 22rpx;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  background: #f7f7f7;
  color: var(--ink);
  font-size: 28rpx;
}

.input {
  min-height: 80rpx;
}

.topic-input {
  min-height: 96rpx;
  margin-top: 0;
  border: 0;
  background: #f6f6f6;
  font-size: 29rpx;
}

.textarea {
  min-height: 144rpx;
  padding-top: 18rpx;
  padding-bottom: 18rpx;
  line-height: 1.58;
}

.picker-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
  margin-top: 18rpx;
}

.picker-box {
  display: flex;
  min-height: 84rpx;
  flex-direction: column;
  justify-content: center;
  padding: 15rpx 18rpx;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  background: #f7f7f7;
  color: var(--ink);
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.42;
}

.picker-box text:first-child {
  color: var(--muted);
  font-size: 23rpx;
  font-weight: 700;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding: 14rpx 18rpx;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  background: #f7f7f7;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 800;
}

.button {
  display: flex;
  min-height: 84rpx;
  align-items: center;
  justify-content: center;
  padding: 16rpx 22rpx;
  border-radius: 10rpx;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.35;
  text-align: center;
  white-space: normal;
  overflow-wrap: anywhere;
}

.button--primary {
  background: var(--xhs-red);
  color: #ffffff;
  box-shadow: var(--shadow-action);
}

.button--ghost {
  border: 1rpx solid var(--line-red);
  background: var(--surface-red);
  color: var(--xhs-red);
}

.button--subtle {
  border: 1rpx solid var(--line);
  background: #ffffff;
  color: var(--ink-soft);
}

.button--favorited,
.favorited {
  border-color: var(--line-red) !important;
  background: var(--surface-red) !important;
  color: var(--xhs-red) !important;
}

.content-box {
  margin-top: 18rpx;
  padding: 24rpx;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  background: #f7f7f7;
  color: var(--ink);
  font-size: 28rpx;
  line-height: 1.68;
  word-break: break-word;
  overflow-wrap: anywhere;
  white-space: pre-wrap;
}

.action-row,
.action-grid {
  display: grid;
  gap: 12rpx;
  margin-top: 18rpx;
}

.mini-button,
.small-button {
  min-height: 66rpx;
  border: 1rpx solid var(--line);
  border-radius: 10rpx;
  background: #ffffff;
  color: var(--ink-soft);
  font-size: 25rpx;
  font-weight: 900;
  line-height: 66rpx;
}

.mini-button--primary {
  border-color: var(--xhs-red);
  background: var(--xhs-red);
  color: #ffffff;
}

.skeleton-list {
  padding-top: 4rpx;
}

.skeleton-card {
  margin-top: 12rpx;
  padding: 22rpx;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  background: #ffffff;
}

.skeleton-line {
  height: 22rpx;
  border-radius: 6rpx;
  background: linear-gradient(90deg, #eeeeee 25%, #f7f7f7 50%, #eeeeee 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.3s ease-in-out infinite;
}

.skeleton-line--meta {
  width: 32%;
}

.skeleton-line--title {
  width: 76%;
  height: 30rpx;
  margin-top: 22rpx;
}

.skeleton-line--body {
  width: 92%;
  margin-top: 16rpx;
}

@keyframes skeleton-loading {
  from {
    background-position: 100% 0;
  }
  to {
    background-position: -100% 0;
  }
}

.request-error {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  border: 1rpx solid #ffd9ad;
  border-radius: 12rpx;
  background: #fff9ed;
}

.request-error__main {
  min-width: 0;
  flex: 1;
}

.request-error__title {
  color: #7c5115;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.4;
}

.request-error__desc {
  margin-top: 3rpx;
  color: #9a713a;
  font-size: 23rpx;
  line-height: 1.45;
  overflow-wrap: anywhere;
}

.request-error__retry {
  display: flex;
  min-height: 66rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  padding: 0 16rpx;
  border-radius: 10rpx;
  background: #ffedcf;
  color: #7c5115;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.35;
}
