<view class="tab-shell">
  <view class="tab-bar">
    <view
      wx:for="{{list}}"
      wx:key="pagePath"
      class="tab-item {{selected === index ? 'tab-item--active' : ''}}"
      hover-class="tab-item--pressed"
      aria-role="button"
      aria-label="{{item.text}}"
      data-path="{{item.pagePath}}"
      data-index="{{index}}"
      bindtap="switchTab"
    >
      <view class="tab-icon">
        <image class="tab-icon__image" src="{{selected === index ? item.selectedIconPath : item.iconPath}}" mode="aspectFit"></image>
      </view>
      <text class="tab-label">{{item.text}}</text>
    </view>
  </view>
</view>
