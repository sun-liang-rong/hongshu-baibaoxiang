.tab-shell {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 999;
  padding: 0 0 env(safe-area-inset-bottom);
  border-top: 1rpx solid #f2dfe3;
  background: rgba(255, 255, 255, 0.98);
  pointer-events: none;
}

.tab-bar {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  height: 104rpx;
  padding: 6rpx 20rpx;
  background: transparent;
  pointer-events: auto;
}

.tab-item {
  position: relative;
  display: flex;
  min-width: 0;
  height: 92rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #8a8a8a;
}

.tab-item--active {
  color: #ff2442;
}

.tab-item--pressed {
  opacity: 0.62;
}

.tab-item::after {
  display: none;
}

.tab-icon {
  display: flex;
  width: 54rpx;
  height: 42rpx;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  background: transparent;
}

.tab-item--active .tab-icon {
  background: #fff0f3;
}

.tab-icon__image {
  display: block;
  width: 38rpx;
  height: 38rpx;
}

.tab-label {
  margin-top: 4rpx;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1.2;
}
